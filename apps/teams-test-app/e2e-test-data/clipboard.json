{
  "name": "Clipboard",
  "version": ">2.14.0",
  "platforms": "*",
  "testCases": [
    {
      "title": "Copy Text - success",
      "type": "callResponse",
      "boxSelector": "#box_copyText",
      "inputValue": "Hello Team",
      "expectedTestAppValue": "true"
    },
    {
      "title": "Copy Text - failure",
      "type": "callResponse",
      "boxSelector": "#box_copyText",
      "inputValue": "\"\"",
      "skipJsonStringifyOnInputValue": true,
      "expectedTestAppValue": "Error: String can't be empty"
    },
    {
      "title": "Copy JPEG Image - success",
      "type": "callResponse",
      "boxSelector": "#box_copyImage",
      "inputValue": "image/jpeg",
      "expectedTestAppValue": "true"
    },
    {
      "title": "Copy PNG Image - success",
      "type": "callResponse",
      "boxSelector": "#box_copyImage",
      "inputValue": "image/png",
      "expectedTestAppValue": "true"
    },
    {
      "title": "Copy Image - failure",
      "type": "callResponse",
      "boxSelector": "#box_copyImage",
      "inputValue": "\"\"",
      "skipJsonStringifyOnInputValue": true,
      "expectedTestAppValue": "Error: mimeType can't be empty"
    },
    {
      "title": "hasClipboardReadPermission API Call - Success",
      "type": "callResponse",
      "version": ">=2.59.0",
      "hostSdkVersion": {
        "web": ">=12.4.0"
      },
      "boxSelector": "#box_hasClipboardReadPermission",
      "expectedTestAppValue": "false"
    },
    {
      "title": "requestClipboardReadPermission API Call - Success",
      "type": "callResponse",
      "version": ">=2.59.0",
      "hostSdkVersion": {
        "web": ">=12.4.0"
      },
      "boxSelector": "#box_requestClipboardReadPermission",
      "isRequestPermissionCall": { "repeatRequestPermissionCall": false },
      "expectedTestAppValue": "true"
    },
    {
      "title": "repeat requestClipboardReadPermission API Call with no dialog - Success",
      "type": "callResponse",
      "version": ">=2.59.0",
      "hostSdkVersion": {
        "web": ">=12.4.0"
      },
      "boxSelector": "#box_requestClipboardReadPermission",
      "isRequestPermissionCall": { "repeatRequestPermissionCall": true },
      "expectedTestAppValue": "true"
    }
  ]
}
